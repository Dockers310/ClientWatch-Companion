{
  "schemaVersion": 1,
  "id": "clientwatch-companion",
  "version": "${version}",
  "name": "ClientWatch Companion",
  "description": "Пассивный мод ClientWatch: по запросу сервера передаёт список загруженных Fabric-модов, версии, SHA-512, SHA-1 и доступные сведения о клиенте/лаунчере. Не имеет команд и своего меню.",
  "authors": ["Dok_Si"],
  "license": "MIT",
  "icon": "assets/clientwatch-companion/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "com.example.clientwatch.ClientWatchCompanionClient",
        "adapter": "kotlin"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.152.0+26.2",
    "fabric-language-kotlin": "*"
  }
}